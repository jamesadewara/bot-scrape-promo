# Copy to .env and edit. Every setting is PROMOSCOUT_ + its name in upper case.

# Price filter: price < MAX_PRICE_NGN OR old price < MAX_OLD_PRICE_NGN (plus 80%+ off)
PROMOSCOUT_MAX_PRICE_NGN=20000
PROMOSCOUT_MAX_OLD_PRICE_NGN=1000000

# Batch size (PRD defaults shown)
# PROMOSCOUT_MAX_LINKS_PER_RUN=300
# PROMOSCOUT_MAX_RUNTIME_MINUTES=30

# Auto mode: rest = batch time x REST_FACTOR, between MIN and MAX minutes (MAX after pushback)
# PROMOSCOUT_AUTO_REST_FACTOR=1.0
# PROMOSCOUT_AUTO_MIN_COOLDOWN_MINUTES=15
# PROMOSCOUT_AUTO_MAX_COOLDOWN_MINUTES=60
# PROMOSCOUT_AUTO_MAX_RUNS_PER_DAY=24
