# Copy to .env and edit. Every setting is PROMOSCOUT_ + its name in upper case.

# Price filter: price < MAX_PRICE_NGN OR old price < MAX_OLD_PRICE_NGN (plus 80%+ off)
PROMOSCOUT_MAX_PRICE_NGN=20000
PROMOSCOUT_MAX_OLD_PRICE_NGN=1000000

# Batch size
PROMOSCOUT_MAX_LINKS_PER_RUN=300
PROMOSCOUT_MAX_RUNTIME_MINUTES=30
# stop a batch early after this many new 80%+ finds (PRD default 30; high = use the full batch)
PROMOSCOUT_TARGET_CANDIDATES=300

# Auto mode: rest = batch time x REST_FACTOR, between MIN and MAX minutes (MAX after server pushback);
# a batch that failed without doing work is retried after RETRY minutes (doubling each time)
PROMOSCOUT_AUTO_REST_FACTOR=1.0
PROMOSCOUT_AUTO_MIN_COOLDOWN_MINUTES=3
PROMOSCOUT_AUTO_MAX_COOLDOWN_MINUTES=60
PROMOSCOUT_AUTO_RETRY_MINUTES=2
PROMOSCOUT_AUTO_MAX_RUNS_PER_DAY=24

# Event days (treasure hunts release items on the hour): true = start batches at HH:01
PROMOSCOUT_AUTO_ALIGN_TO_HOUR=false
PROMOSCOUT_AUTO_ALIGN_MINUTE=1

# Known campaign pages checked every batch (JSON list)
PROMOSCOUT_PROMO_SEED_PATHS=["/phones-tablets/flash-sales/","/electronics/flash-sales/","/computing/flash-sales/","/phones-tablets/","/smartphones/","/electronics/","/computing/","/flash-sales/","/mlp-black-friday/","/mlp-clearance/","/mlp-clearance-sale/","/mlp-anniversary/","/mlp-treasure-hunt/","/mlp-jumia-black-friday-snatch-it-challenge/","/mlp-11-11/","/mlp-12-12/"]

# Gadgets first: extra priority for phone/laptop/TV/audio/wearable/gaming/brand pages (0 = off)
PROMOSCOUT_FOCUS_BONUS=40
# phones get this on top of FOCUS_BONUS
PROMOSCOUT_PHONE_BONUS=20

# Review queue: hide unreviewed finds under KEEP_MIN after HIDE_AFTER hours, and finds not seen
# for STALE hours. Hidden finds are not re-verified and return only if their price changes.
PROMOSCOUT_REVIEW_HIDE_AFTER_HOURS=48
PROMOSCOUT_REVIEW_KEEP_MIN_DISCOUNT=90
PROMOSCOUT_REVIEW_STALE_HOURS=72

# Fake-discount check: flag old_price_inflated if old price > FACTOR x price of similar items (0 = off)
PROMOSCOUT_INFLATION_FACTOR=3.0

# Learning: page families gain priority from recent finds per page; proven-poor families
# (MIN_PAGES+ pages, under POOR_YIELD finds per page) are pushed down and lose the gadget bonus
PROMOSCOUT_LEARN_WINDOW_DAYS=1
PROMOSCOUT_LEARN_MIN_PAGES_FOR_PENALTY=6
PROMOSCOUT_LEARN_POOR_YIELD=0.1
# look-alike pages (e.g. /mlp-samsung-*/) per batch unless the family gave an 80%+ find
PROMOSCOUT_FAMILY_CAP_PER_RUN=6

# HOT banner / alerts.log / email for finds at or above this discount
PROMOSCOUT_ALERT_MIN_DISCOUNT=95

# Email (Gmail SMTP). Password = Gmail app password (Google Account > Security > App passwords)
PROMOSCOUT_EMAIL_ENABLED=false
PROMOSCOUT_SMTP_USER=yourbot@gmail.com
PROMOSCOUT_SMTP_PASSWORD=abcdabcdabcdabcd
PROMOSCOUT_EMAIL_TO=first@gmail.com,second@gmail.com
# hot = email when new finds reach ALERT_MIN_DISCOUNT; new = email for any new 80%+ find
PROMOSCOUT_EMAIL_TRIGGER=hot
PROMOSCOUT_EMAIL_TOP_N=10
# server with public review page: http://<elastic-ip>:8501
PROMOSCOUT_REVIEW_URL=http://localhost:8501
# review page password (required on a public IP; the page will not open without it)
PROMOSCOUT_REVIEW_PASSWORD=
# problem emails (blocked, Jumia unreachable, auto mode stopped): max one per kind per N hours
PROMOSCOUT_PROBLEM_EMAIL_EVERY_HOURS=6
